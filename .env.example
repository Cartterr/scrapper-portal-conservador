# Ubuntu: copie este archivo a .env y complete únicamente las credenciales.
# Agregue o quite pares CBRS_EJECUTIVO_1..N. Los números pueden tener saltos.
# Si existe account-pool.json con cuentas explícitas, ese archivo tiene prioridad.
CBRS_EJECUTIVO_1_USERNAME=
CBRS_EJECUTIVO_1_PASSWORD=
CBRS_EJECUTIVO_2_USERNAME=
CBRS_EJECUTIVO_2_PASSWORD=
CBRS_EJECUTIVO_3_USERNAME=
CBRS_EJECUTIVO_3_PASSWORD=
DATAIMPULSE_PROXY_LOGIN=
DATAIMPULSE_PROXY_PASSWORD=

# Opcionales. Chrome regular y reCAPTCHA del navegador funcionan sin claves.
# CBRS_2CAPTCHA_API_KEY=
# CBRS_CAPSOLVER_API_KEY=
# Con una clave se selecciona automáticamente el fallback correspondiente.
# Para desactivarlo explícitamente: CBRS_CAPTCHA_SOLVER_MODE=browser
# CBRS_BROWSER_BACKEND=chrome
# Headless no sirve: el portal rechaza el reCAPTCHA de búsqueda de Chrome headless.
# En Linux sin pantalla, use headful sobre Xvfb (DISPLAY=:99; ver deploy/cbrs-display.service
# o `xvfb-run -n 99 -s "-screen 0 1366x900x24 -nolisten tcp" cbrs jobs worker`).
# CBRS_HEADLESS=0
# Renovación del token de acceso (30 min) desde la página autenticada cuando le quedan
# menos de estos segundos; rota la cookie de refresco de 7 días (0 = apagado; mínimo 60).
# CBRS_SESSION_KEEPALIVE_SECONDS=300
# CBRS_WINDOW_MODE=normal
# CBRS_EXPECTED_EGRESS_COUNTRY=CL
# CBRS_REQUEST_DELAY_SECONDS=5
# CBRS_SEARCH_SUBMISSION_TIMEOUT_SECONDS=90
# CBRS_SEARCH_RESPONSE_TIMEOUT_SECONDS=90
# DATAIMPULSE_PROXY_HOST=gw.dataimpulse.com
# DATAIMPULSE_PROXY_SCHEME=http
# DATAIMPULSE_COUNTRY=cl
# DATAIMPULSE_STICKY_TTL_MINUTES=120
# DATAIMPULSE_STICKY_PORT_MIN=10000
# DATAIMPULSE_STICKY_PORT_MAX=20000
# CBRS_DATAIMPULSE_CANDIDATES_PER_RECOVERY=10
# CBRS_DATAIMPULSE_MAX_ROTATIONS_PER_HOUR=30
# Logins nuevos por cuenta en 24 h al reemplazar rutas (una cuenta sola: considere 3-5).
# CBRS_DATAIMPULSE_MAX_CANDIDATE_LOGINS_PER_DAY=10
# CBRS_DATAIMPULSE_CANARY_PER_HOUR=12
# CBRS_DATAIMPULSE_CANARY_SPACING_SECONDS=60
# CBRS_DATAIMPULSE_CANDIDATE_RETRY_SECONDS=10
# CBRS_DATAIMPULSE_ROTATION_COOLDOWN_SECONDS=60
# La unidad systemd del worker selecciona el propietario externo de Chrome.
# Fuera de systemd, el valor predeterminado es embedded.
# CBRS_BROWSER_OWNER_MODE=embedded
# Recuperación de login restringida a IDs autorizados; vacío por defecto.
# CBRS_FAILED_LOGIN_REPLACEMENT_ACCOUNTS=
# Rechazos de CAPTCHA en login sobre la misma salida antes de rotar sin
# evidencia visible; el código explícito captcha-rechazado rota de inmediato.
# CBRS_LOGIN_CAPTCHA_ROTATE_AFTER=3

# --- Pipeline de registro de cuentas nuevas (cbrs.registration) -------------
# Dominio catch-all (Cloudflare Email Routing) que reenvia todo a un Gmail.
# CBRS_ACTIVATION_DOMAIN=
# Buzon Gmail que recibe los reenvios; se lee por IMAP con app password.
# CBRS_ACTIVATION_IMAP_HOST=imap.gmail.com
# CBRS_ACTIVATION_IMAP_PORT=993
# CBRS_ACTIVATION_IMAP_USER=
# CBRS_ACTIVATION_IMAP_PASSWORD=
# Celular nacional de 9 digitos (comienza con 9) para el formulario.
# CBRS_REGISTRATION_CELULAR=986552408
# CBRS_REGISTRATION_RUT_DB=rut_data.db
# CBRS_REGISTRATION_ACCOUNTS_DB=registered_accounts.db
# CBRS_REGISTRATION_PROFILE_ROOT=.cbrs/registration-profiles
# El portal rechaza el reCAPTCHA de Chrome headless (D29/D30): no activar.
# CBRS_REGISTRATION_HEADLESS=0
# CBRS_REGISTRATION_ACTIVATION_TIMEOUT_SECONDS=600
# CBRS_REGISTRATION_ACTIVATION_POLL_SECONDS=15
# CBRS_REGISTRATION_REQUEST_DELAY_SECONDS=2
# Direccion fija opcional para el formulario (por defecto: pool interno).
# CBRS_REGISTRATION_DIRECCION=
