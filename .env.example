# Local native-Windows development template. Never commit the populated .env.
CBRS_PROFILE_DIR=G:\CBRS\chrome-profile
CBRS_OUTPUT_DIR=G:\CBRS\outputs
CBRS_LOG_DIR=G:\CBRS\logs
CBRS_CAPTCHA_STATE_PATH=G:\CBRS\pool\pool.sqlite3
CBRS_BROWSER_BACKEND=chrome
CBRS_BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CBRS_HEADLESS=1
CBRS_WINDOW_MODE=normal
CBRS_EGRESS_MODE=residential_sticky
CBRS_EXPECTED_EGRESS_COUNTRY=CL
CBRS_REQUEST_DELAY_SECONDS=5
CBRS_PROXY_RECHECK_SECONDS=300
CBRS_BROWSER_HEALTHCHECK_SECONDS=30
CBRS_BROWSER_REAUTH_BACKOFF_SECONDS=60
CBRS_USE_CURL_CFFI_FOR_IMAGES=false

# DataImpulse dashboard credentials are admin-only; the worker never uses them.
DATAIMPULSE_EMAIL=REPLACE_ME
DATAIMPULSE_PASSWORD=REPLACE_ME
# Proxy credentials are shown in the DataImpulse proxy configuration.
DATAIMPULSE_PROXY_LOGIN=REPLACE_ME
DATAIMPULSE_PROXY_PASSWORD=REPLACE_ME
DATAIMPULSE_PROXY_HOST=gw.dataimpulse.com
DATAIMPULSE_COUNTRY=cl
DATAIMPULSE_STICKY_TTL_MINUTES=120
DATAIMPULSE_STICKY_PORT_MIN=10000
DATAIMPULSE_STICKY_PORT_MAX=20000
CBRS_DATAIMPULSE_ROTATION_COOLDOWN_SECONDS=300
CBRS_DATAIMPULSE_MAX_ROTATIONS_PER_HOUR=3
CBRS_DATAIMPULSE_TEMP_UNAVAILABLE_THRESHOLD=2

CBRS_EJECUTIVO_1_USERNAME=REPLACE_ME
CBRS_EJECUTIVO_1_PASSWORD=REPLACE_ME
CBRS_EJECUTIVO_2_USERNAME=REPLACE_ME
CBRS_EJECUTIVO_2_PASSWORD=REPLACE_ME
CBRS_EJECUTIVO_3_USERNAME=REPLACE_ME
CBRS_EJECUTIVO_3_PASSWORD=REPLACE_ME

# Keep both keys available, but select only one provider mode.
CBRS_CAPTCHA_SOLVER_MODE=capsolver_manual
CBRS_2CAPTCHA_API_KEY=REPLACE_ME
CBRS_2CAPTCHA_MIN_SCORE=0.9
CBRS_2CAPTCHA_TIMEOUT_SECONDS=120
CBRS_2CAPTCHA_POLL_SECONDS=5
CBRS_2CAPTCHA_DAILY_LIMIT=60
CBRS_2CAPTCHA_CIRCUIT_BREAKER_SECONDS=300
CBRS_2CAPTCHA_REJECTION_COOLDOWN_SECONDS=300
CBRS_CAPSOLVER_API_KEY=REPLACE_ME
CBRS_CAPSOLVER_TIMEOUT_SECONDS=120
CBRS_CAPSOLVER_POLL_SECONDS=3

RESTIC_REPOSITORY=E:\CBRS-backup\restic
RESTIC_PASSWORD_FILE=C:\ProgramData\CBRS\restic-password
CBRS_RESTIC_EXECUTABLE_PATH=C:\ProgramData\CBRS\bin\restic.exe
