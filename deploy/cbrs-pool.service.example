[Unit]
Description=CBRS legacy account-pool diagnostic dry-run
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cbrs
Group=cbrs
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@REPO_ROOT@/.env
ExecStart=@REPO_ROOT@/.venv/bin/python -m cbrs pool run --dry-run
Restart=on-failure
RestartSec=15
KillSignal=SIGINT
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@REPO_ROOT@/.cbrs/runtime

[Install]
WantedBy=multi-user.target
