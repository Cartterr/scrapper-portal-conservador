[Unit]
Description=CBRS durable sequential job worker
Wants=network-online.target
Requires=cbrs-browser-owner.service
After=network-online.target cbrs-browser-owner.service
StartLimitIntervalSec=300
StartLimitBurst=12

[Service]
Type=simple
User=cbrs
Group=cbrs
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@REPO_ROOT@/.env
Environment=HOME=@REPO_ROOT@/.cbrs/runtime
Environment=DISPLAY=:99
Environment=TMPDIR=@REPO_ROOT@/.cbrs/runtime/tmp
UMask=0027
ExecStartPre=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/deploy/linux_control.py wait-owner
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/deploy/run_with_env.py @REPO_ROOT@/.env -- @REPO_ROOT@/.venv/bin/python -m cbrs jobs worker
ExecStop=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/deploy/linux_control.py drain-worker
Restart=on-failure
RestartSec=20
KillSignal=SIGINT
TimeoutStopSec=180
KillMode=process
SendSIGKILL=no
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@REPO_ROOT@/.cbrs/runtime @REPO_ROOT@/.cbrs/runtime/logs

[Install]
WantedBy=multi-user.target
