[Unit]
Description=CBRS loopback-only noVNC browser recovery
Requires=cbrs-x11vnc.service
After=cbrs-x11vnc.service

[Service]
Type=simple
User=cbrs
Group=cbrs
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
