[Unit]
Description=CBRS loopback dashboard and jobs API
Wants=cbrs-novnc.service
After=network.target cbrs-novnc.service

[Service]
Type=simple
User=cbrs
Group=cbrs
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@REPO_ROOT@/.env
Environment=HOME=@REPO_ROOT@/.cbrs/runtime
Environment=CBRS_NOVNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale
UMask=0027
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/deploy/run_with_env.py @REPO_ROOT@/.env -- @REPO_ROOT@/.venv/bin/python -m cbrs jobs dashboard --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@REPO_ROOT@/.cbrs/runtime @REPO_ROOT@/.cbrs/runtime/logs

[Install]
WantedBy=multi-user.target
