CBRS_BROWSER_BACKEND=chrome
CBRS_BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
CBRS_HEADLESS=1
CBRS_WINDOW_MODE=normal
CBRS_EGRESS_MODE=dedicated_static_isp
CBRS_EXPECTED_EGRESS_COUNTRY=CL
CBRS_PROFILE_DIR=/var/lib/cbrs/chrome-profile
CBRS_OUTPUT_DIR=/var/lib/cbrs/outputs
CBRS_LOG_DIR=/var/log/cbrs
CBRS_REQUEST_DELAY_SECONDS=5
CBRS_PROXY_RECHECK_SECONDS=300
CBRS_NOVNC_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale
DISPLAY=:99

# Optional automatic reCAPTCHA v3 Enterprise fallback. Keep the key outside Git.
CBRS_CAPTCHA_SOLVER_MODE=browser
CBRS_2CAPTCHA_API_KEY=
CBRS_CAPSOLVER_API_KEY=
CBRS_CAPSOLVER_TIMEOUT_SECONDS=120
CBRS_CAPSOLVER_POLL_SECONDS=3
CBRS_2CAPTCHA_MIN_SCORE=0.9
CBRS_2CAPTCHA_TIMEOUT_SECONDS=120
CBRS_2CAPTCHA_POLL_SECONDS=5
CBRS_2CAPTCHA_DAILY_LIMIT=60
CBRS_2CAPTCHA_CIRCUIT_BREAKER_SECONDS=300
CBRS_2CAPTCHA_REJECTION_COOLDOWN_SECONDS=300
CBRS_CAPTCHA_STATE_PATH=/var/lib/cbrs/pool/pool.sqlite3

# Each authorized account uses distinct secret references from account-pool.json.
CBRS_ACCOUNT_1_USERNAME=
CBRS_ACCOUNT_1_PASSWORD=
CBRS_ACCOUNT_1_PROXY_URL=
CBRS_ACCOUNT_2_USERNAME=
CBRS_ACCOUNT_2_PASSWORD=
CBRS_ACCOUNT_2_PROXY_URL=
CBRS_ACCOUNT_3_USERNAME=
CBRS_ACCOUNT_3_PASSWORD=
CBRS_ACCOUNT_3_PROXY_URL=

# restic reads these directly. Prefer RESTIC_PASSWORD_FILE over a plaintext value.
RESTIC_REPOSITORY=/srv/cbrs-backup/restic
RESTIC_PASSWORD_FILE=/etc/cbrs/restic-password
