[Unit]
Description=Apply a fixed local CBRS account-configuration request

[Service]
Type=oneshot
User=root
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/deploy/configure_runtime.py --update-accounts-only --request-file @REPO_ROOT@/.cbrs/runtime/control/account-configuration.json
ExecStartPost=/usr/bin/systemctl try-restart cbrs-dashboard.service
