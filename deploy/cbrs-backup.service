[Unit]
Description=CBRS encrypted permanent evidence backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cbrs
Group=cbrs
WorkingDirectory=@REPO_ROOT@
EnvironmentFile=@REPO_ROOT@/.env
Environment=HOME=@REPO_ROOT@/.cbrs/runtime
UMask=0027
ExecStart=@REPO_ROOT@/.venv/bin/python -m cbrs jobs backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The backup is repository-local; see the disaster-recovery limitation in docs.
ReadWritePaths=@REPO_ROOT@/.cbrs/runtime
