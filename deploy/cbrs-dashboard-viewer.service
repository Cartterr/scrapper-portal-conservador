[Unit]
Description=CBRS WSLg dashboard viewer
Wants=cbrs-dashboard.service
After=cbrs-dashboard.service
ConditionPathExists=/tmp/.X11-unix/X0

[Service]
Type=simple
User=cbrs
Group=cbrs
Environment=HOME=/var/lib/cbrs
Environment=DISPLAY=:0
WorkingDirectory=/var/lib/cbrs
ExecStart=/usr/bin/google-chrome --user-data-dir=/var/lib/cbrs/dashboard-viewer --app=http://127.0.0.1:8765/ --no-first-run --no-default-browser-check
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
